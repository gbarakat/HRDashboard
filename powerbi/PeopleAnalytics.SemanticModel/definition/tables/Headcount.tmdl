/// Grain: employee x month end (2017-12-31 opening balance + 96 months).
table Headcount
	lineageTag: fdbf265f-b5b9-5c1b-be19-baaaaf86bf95

	column month_end
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: ce2e074a-6dd8-564c-aa00-7d32a1f266d7
		summarizeBy: none
		sourceColumn: month_end

		annotation UnderlyingDateTimeDataType = Date

	column emp_id
		dataType: string
		isHidden
		lineageTag: f50294ee-da74-5d6d-a697-898f7c9f4d4d
		summarizeBy: none
		sourceColumn: emp_id

	column employee_key
