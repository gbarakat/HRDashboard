	partition Location = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PgServer, PgDatabase),
				    Data = Source{[Schema = "core", Item = "dim_location"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table

